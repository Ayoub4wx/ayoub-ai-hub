# ─── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci.

# ─── OpenRouter AI ──────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_SITE_URL=https://yourdomain.co
OPENROUTER_SITE_NAME=Ayoub AI Hub

# Groq AI (preferred for AI Blogger if present)
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# X / Twitter API (optional, used for latest X AI posts in AI Blogger)
X_BEARER_TOKEN=your-x-api-bearer-token

# ─── YouTube Data API v3 ────────────────────────────────────
YOUTUBE_API_KEY=AIza...
YOUTUBE_CHANNEL_ID=UCxxxxxx

# ─── MailerLite ─────────────────────────────────────────────
MAILERLITE_API_KEY=eyJ0eXAi...
MAILERLITE_GROUP_ID=123456789

# ─── Resend (contact form) ──────────────────────────────────
RESEND_API_KEY=re_...
CONTACT_EMAIL=your@email.com

# ─── Analytics ──────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Instagram (optional) ───────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=IGQVJx...
INSTAGRAM_USER_ID=123456

# ─── Cron Jobs ──────────────────────────────────────────────
# Generate with: openssl rand -hex 32
CRON_SECRET=your-random-secret-here

# Admin panel for managing AI Blogger without normal user auth
AI_BLOGGER_ADMIN_PASSWORD=change-this-password

# ─── App Config ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://yourdomain.com
NEXT_PUBLIC_APP_NAME=Ayoub AI Hub
